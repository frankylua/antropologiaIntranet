APP_NAME="Doctorado Antropología"
APP_ENV=prod
APP_URL=http://localhost/antropologiaIntranet/

DB_HOST=localhost
DB_NAME=db_antr_doc
DB_USERNAME=root
DB_PASS=
DB_ENCODE=utf8mb4

# Intentos de login: carpeta local privada fuera de htdocs/webroot.
# Vacío utiliza una subcarpeta propia del directorio temporal de PHP.
LOGIN_RATE_LIMIT_DIR=
LOGIN_RATE_ACCOUNT_MAX=5
LOGIN_RATE_IP_MAX=60
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_BLOCK_SECONDS=60

# Recuperación de contraseña. Completar solo en .env local (no versionarlo).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Doctorado en Antropología"
# Vacío: store SQLite operativo privado fuera del webroot, por app/base.
PASSWORD_RESET_DIR=
